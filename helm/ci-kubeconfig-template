apiVersion: v1
kind: Config
clusters:
- cluster:
    certificate-authority-data: <CA_DATA>
    server: <SERVER_URL>
  name: karton-cluster
contexts:
- context:
    cluster: karton-cluster
    namespace: karton
    user: ci-helm
  name: karton-context
current-context: karton-context
users:
- name: ci-helm
  user:
    token: <CI_HELM_TOKEN>
